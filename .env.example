# Gemini — drives the agent loop (it decides which tools to call).
# Get a free key at aistudio.google.com
GEMINI_API_KEY=your-key-here

# Optional: the model the agent runs on. Default gemini-3.6-flash.
# RISK_AGENT_MODEL=gemini-3.6-flash

# Tavily — the agent's web_search tool (qualitative context + sources).
# Get a free key at tavily.com. Without it, reports build from the numbers only.
TAVILY_API_KEY=your-tavily-key-here
